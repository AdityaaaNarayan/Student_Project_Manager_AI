# Copy this file to .env and fill in ONE of the keys below to use a real LLM.
# Without any key, the Planning Agent automatically runs in offline mock mode.
#
# Recommended for students: GEMINI_API_KEY, since Google AI Studio offers a
# free tier (no credit card needed). Get one at https://aistudio.google.com
#
# If both keys are set, Gemini is used by default. Set LLM_PROVIDER below to
# force a specific choice instead.

GEMINI_API_KEY=
# "gemini-flash-latest" auto-points to Google's newest Flash model, so it
# won't break when a specific version (like gemini-2.5-flash) gets retired.
# You can pin an exact version instead if you want stable, reproducible
# behavior for a report/demo, e.g. GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL=gemini-flash-latest

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: force "gemini" or "anthropic" instead of auto-detecting.
LLM_PROVIDER=

# Optional: only needed for private repos or to raise GitHub's rate limit
# (60 req/hour without a token) when using the "Auto-fetch from GitHub"
# feature in the Monitor & Adapt section. Create one at
# https://github.com/settings/tokens (a "fine-grained" read-only token
# scoped to the repo(s) you'll monitor is enough).
GITHUB_TOKEN=
